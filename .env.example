# Copy to .env; keep real keys out of Git.
# Backend pages/CRUD work without model keys; live interviews require valid keys.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_OMNI_MODEL=qwen3.8-omni-flash-realtime
QWEN_OMNI_VOICE=Tina
# Optional avatar service; not required by the current image-based interview page.
HEYGEN_API_KEY=
# LOCAL TESTING ONLY. Disable before deployment; this is not authentication.
DEV_ENDPOINTS=false
# DATABASE_URL omitted: uses backend/interviewai.db (SQLite).

# Replace YOUR_WORKSPACE_ID with the workspace matching your API key.
QWEN_OMNI_WS_URL=wss://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# AI-answer similarity check (post-interview). Any OpenAI-compatible /embeddings
# endpoint works, including a self-hosted open-source model such as bge-m3.
# Defaults: DashScope compatible mode, authenticated with DASHSCOPE_API_KEY.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
